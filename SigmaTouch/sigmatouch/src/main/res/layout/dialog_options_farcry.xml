<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_border_color"
    android:padding="5sp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

        <include
            android:id="@+id/gl_resolution"
            layout="@layout/widget_view_resolution_select" />

        <include
            android:id="@+id/aim_assist_spinner"
            layout="@layout/widget_view_spinner" />

        <include
            android:id="@+id/dev_mode_switch"
            layout="@layout/widget_view_switch" />

        <include
            android:id="@+id/decal_spinner"
            layout="@layout/widget_view_spinner" />

        <include
            android:id="@+id/upload_mode_spinner"
            layout="@layout/widget_view_spinner" />

        <include
            android:id="@+id/map_mode_spinner"
            layout="@layout/widget_view_spinner" />

        <include
            android:id="@+id/gles_debug_switch"
            layout="@layout/widget_view_switch" />

        <include
            android:id="@+id/start_level_spinner"
            layout="@layout/widget_view_spinner" />

        <include
            android:id="@+id/gamepad_config_spinner"
            layout="@layout/widget_view_gamepad_config" />

        <include
            android:id="@+id/delete_data_button"
            layout="@layout/widget_view_delete_data" />

    </LinearLayout>
</ScrollView>
